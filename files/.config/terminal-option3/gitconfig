[core]
    pager = delta
[interactive]
    diffFilter = delta --color-only
[delta]
    navigate = true
    line-numbers = true
    side-by-side = true
    dark = true
    syntax-theme = Neon Black
    minus-style = syntax "#260b12"
    plus-style = syntax "#082618"
    file-style = bold "#00e5ff"
    hunk-header-style = file line-number syntax
[merge]
    conflictStyle = zdiff3
